# SIH26092 Environment Configuration (Template)
# Copy this file to .env and configure your local settings.
# IMPORTANT: Never commit the actual .env file to Git.

ENVIRONMENT=development
PORT=8000
SECRET_KEY=dev_secret_key_change_in_production_sih26092

# ─── Database Connection (PostgreSQL via asyncpg) ───────────────────────────
# For local development:
#   DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/scheme_matcher
#
# For Supabase PostgreSQL:
#   Obtain the connection string from:
#   Supabase Dashboard → Connect → PostgreSQL connection string
#
#   Session Pooler (recommended for FastAPI/asyncpg):
#   DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
#   Direct connection (if IPv6 accessible):
#   DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
#
#   Note: If using Supabase Transaction Pooler (port 6543), set in database.py:
#   connect_args={"statement_cache_size": 0}  (disables asyncpg prepared statements)
DATABASE_URL=

# Voice Integration (Bhashini - Production / Whisper - Demo)
BHASHINI_ENABLED=false
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_PIPELINE_ID=
WHISPER_MODEL_SIZE=base
GROQ_API_KEY=

# Mappls / MapmyIndia Credentials (Optional Server-Side Routing)
MAPPLS_API_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# Paths
FAISS_INDEX_PATH=data/scheme_vectors.index
SCHEMES_JSON_PATH=data/schemes.json