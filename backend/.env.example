# =============================================================================
# Scheme Saathi (SIH26092) Backend Configuration Template
# Copy this file to .env and configure environment-specific values.
# IMPORTANT: Never commit the actual .env file to Git.
# =============================================================================

ENVIRONMENT=development
PORT=8000
SECRET_KEY=change-me-in-production-use-secrets-token-hex-32

# --- Database Connection (PostgreSQL via asyncpg) ---
# Local development:
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/scheme_matcher

# --- CORS Allowed Origins (Comma-separated) ---
# Local: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Production: https://<your-vercel-domain>.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Voice Integration (Bhashini / Whisper) ---
BHASHINI_ENABLED=false
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_API_KEY=
WHISPER_MODEL_SIZE=base

# --- AI Chatbot (Groq / Gemini) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=

# --- Mappls / MapmyIndia Credentials (Server-Side Routing) ---
MAPPLS_API_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# --- Google OAuth 2.0 Credentials (Server Verification) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_ALGORITHM=HS256
SESSION_EXPIRE_HOURS=72

# --- File Storage & Data Paths ---
UPLOAD_DIR=uploads/documents
MAX_DOCUMENT_SIZE_MB=20
FAISS_INDEX_PATH=data/scheme_vectors.index
SCHEMES_JSON_PATH=data/schemes.json