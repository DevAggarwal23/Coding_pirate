# =============================================================================
# Scheme Saathi (SIH26092) — Frontend Environment Configuration Template
# All variables in this file are exposed to the browser.
# DO NOT place backend secrets, private keys, or database passwords in this file.
# =============================================================================

# Backend API base URL
# Local Development: http://localhost:8000
# Render Production: https://<your-render-service-name>.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 Web Client ID (Public client identifier from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=

# Mappls / MapmyIndia Vector Map Public Key (Optional browser map key)
VITE_MAPPLS_MAP_KEY=
